# Salin file ini menjadi ".env" lalu isi dengan Firebase Web App config
# dari Firebase Console > Project Settings > Your apps > SDK setup and configuration.
#
# Nilai contoh di bawah ("demo-berae-catalog") memakai konvensi khusus Firebase
# Emulator Suite untuk project palsu (prefix "demo-") sehingga bisa langsung
# dipakai untuk development lokal TANPA perlu project Firebase asli/login dulu.
# Ganti dengan config Web App yang sebenarnya saat akan connect ke project asli.
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-berae-catalog.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-berae-catalog
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# Set "true" untuk memakai Firebase Local Emulator Suite saat development
# (npm run dev + npm run emulators), sehingga tidak perlu koneksi ke project asli.
VITE_USE_FIREBASE_EMULATOR=true
