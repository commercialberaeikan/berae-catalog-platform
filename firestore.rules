rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Login Google diizinkan sebagai metode masuk, tapi hanya email tertentu yang
    // dipercaya sebagai admin lewat provider itu. Login email/password (dibuat manual
    // oleh pemilik project di Firebase Console) tetap dipercaya penuh seperti biasa.
    function isTrustedAdmin() {
      return request.auth != null && (
        request.auth.token.firebase.sign_in_provider != 'google.com' ||
        request.auth.token.email == 'commercial.beraeikan@gmail.com'
      );
    }

    match /products/{productId} {
      allow read: if resource.data.status == 'active' || isTrustedAdmin();
      allow create, update, delete: if isTrustedAdmin();
    }

    match /batches/{batchId} {
      allow read: if resource.data.status == 'active' || isTrustedAdmin();
      allow create, update, delete: if isTrustedAdmin();
    }

    // Profil perusahaan ditampilkan publik di halaman Kontak; hanya admin yang boleh ubah.
    match /settings/{docId} {
      allow read: if true;
      allow write: if isTrustedAdmin();
    }
  }
}
